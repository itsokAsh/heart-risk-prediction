# Backend
DATABASE_URL=postgresql+asyncpg://heartguard:heartguard@postgres:5432/heartguard
JWT_SECRET=replace-with-a-strong-64-char-secret-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# AI Explanations (optional — app works without it, but /api/ai/* endpoints require it)
GROQ_API_KEY=your-groq-api-key-here
